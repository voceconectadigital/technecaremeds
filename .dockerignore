# O contexto da imagem é o código versionado — nada de dependências locais,
# artefatos de build, ambiente ou dados de teste.
.git
# Exceção: só o necessário para saber o commit (tools/imagem/versao.mjs).
!.git/HEAD
!.git/refs
!.git/packed-refs
**/node_modules
**/dist
**/*.tsbuildinfo
.env
.env.*
!.env.example
# Em qualquer pasta, não só na raiz (auditoria 23/11/2026, SEG-12).
**/.env
**/.env.*
!**/.env.example
# Estado local de ferramentas (worktrees, sessões) e capturas: nada disso é código.
.claude
capturas
graphify-out
.aurora
.pgdata
*.pglite
coverage
test-results
playwright-report
apps/field/android
apps/field/ios
supabase
null
