# Aurora — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env com valores reais.

# --- aplicação -------------------------------------------------------------
# NODE_ENV é o MODO DE EXECUÇÃO (convenção do Node: development | test |
# production). Meia dúzia de ferramentas ramifica nele.
NODE_ENV=development

# AURORA_AMBIENTE é QUAL IMPLANTAÇÃO ESTA É, e é outra pergunta:
#   desenvolvimento | teste | homologacao | producao
#
# Uma homologação roda com build de produção (NODE_ENV=production) e mesmo assim
# não é produção. Em homologacao e producao a configuração RECUSA:
#   - AURORA_ALLOW_UNSAFE_DEV (entra com qualquer e-mail, sem senha);
#   - AURORA_AUTH_PROVIDER=local (a mesma porta, por outro caminho).
AURORA_AMBIENTE=desenvolvimento

AURORA_PORT=3000
AURORA_LOG_LEVEL=info

# --- banco -----------------------------------------------------------------
# Usuário da aplicação DEVE herdar de aurora_app: sem BYPASSRLS, não-owner.
DATABASE_URL=postgresql://aurora_app_user:senha@localhost:5432/aurora
# Papel assumido por transação (SET LOCAL ROLE). Vazio desativa.
AURORA_DB_APP_ROLE=aurora_app
AURORA_DB_POOL_MAX=10

# --- testes ----------------------------------------------------------------
# Opcional: aponta os testes de banco para um PostgreSQL real em vez de PGlite.
# AURORA_TEST_PG_URL=postgresql://postgres:postgres@localhost:5432/aurora_test

# --- identidade ------------------------------------------------------------
# Provider de autenticação atrás de adapter (nunca chamado direto pelo domínio).
AURORA_AUTH_PROVIDER=local
# AURORA_SUPABASE_URL=
# AURORA_SUPABASE_ANON_KEY=
# service role NUNCA sai do servidor e NUNCA vai para o cliente
# AURORA_SUPABASE_SERVICE_ROLE_KEY=

# --- storage ---------------------------------------------------------------
AURORA_STORAGE_DRIVER=local
# AURORA_S3_ENDPOINT=
# AURORA_S3_BUCKET=
# AURORA_S3_ACCESS_KEY_ID=
# AURORA_S3_SECRET_ACCESS_KEY=
