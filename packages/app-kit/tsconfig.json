{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": "../..",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // `vite/client` pelos tipos de `import.meta.env`: o cliente da API lê a URL
    // da API dali, e sem os tipos o pacote não compila fora de uma aplicação.
    "types": ["vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/__tests__/**"],
  "references": [{ "path": "../contracts" }]
}
