{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@aurora/domain": ["packages/domain/src"],
      "@aurora/events": ["packages/events/src"],
      "@aurora/db": ["packages/db/src"],
      "@aurora/config": ["packages/config/src"],
      "@aurora/contracts": ["packages/contracts/src"],
      "@aurora/ui": ["packages/ui/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
