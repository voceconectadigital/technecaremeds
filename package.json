{
  "name": "aurora",
  "version": "0.1.0",
  "private": true,
  "description": "Aurora — plataforma de gestão de ativos e manutenção",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:build": "node tools/spec/build-v0.2.mjs",
    "spec:audit": "node tools/spec/audit.mjs docs/AURORA-CMMS-SPEC-v0.2.md",
    "verify": "npm run spec:audit && npm run typecheck && npm run lint && npm run openapi:check && npm run test",
    "db:migrate": "node tools/db/run.mjs migrate",
    "db:seed": "node tools/db/run.mjs seed",
    "db:status": "node tools/db/run.mjs status",
    "openapi": "node tools/openapi/generate.mjs",
    "openapi:check": "node tools/openapi/generate.mjs --check",
    "bench:seed": "node tools/bench/seed.mjs",
    "bench": "node tools/bench/run.mjs",
    "e2e:api": "node tools/e2e/api.mjs",
    "e2e:web": "vite --config apps/web/vite.config.ts --port 5311 --strictPort",
    "e2e:db": "node tools/db/run.mjs migrate && node e2e/fixtures/seed.mjs --reset",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:portal": "vite --config apps/portal/vite.config.ts --port 5312 --strictPort",
    "e2e:field": "vite build --config apps/field/vite.config.ts && vite preview --config apps/field/vite.config.ts --port 5313 --strictPort"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.28.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "multer": "^2.3.0",
    "qs": "^6.15.3",
    "file-type": "^21.3.4"
  }
}
