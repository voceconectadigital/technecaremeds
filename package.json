{
  "name": "aurora",
  "version": "0.1.0",
  "private": true,
  "description": "Aurora — plataforma de gestão de ativos e manutenção",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:build": "node tools/spec/build-v0.2.mjs",
    "spec:audit": "node tools/spec/audit.mjs docs/AURORA-CMMS-SPEC-v0.2.md",
    "verify": "npm run spec:audit && npm run typecheck && npm run lint && npm run openapi:check && npm run test",
    "db:migrate": "node tools/db/run.mjs migrate",
    "db:seed": "node tools/db/run.mjs seed",
    "db:status": "node tools/db/run.mjs status",
    "openapi": "node tools/openapi/generate.mjs",
    "openapi:check": "node tools/openapi/generate.mjs --check"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "pg": "^8.23.0",
    "pg-boss": "^12.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.9"
  }
}
